# =====================================================================
# Reel Forge Production Environment Variables
# Copy this file to .env and configure your production credentials.
# =====================================================================

# 1. FastAPI Backend Authentication (Optional for internal development)
REELFORGE_API_KEY=rf_dev_secret_key_2026

# 2. Gemini API Key (Required for autonomous Roman Urdu quote generation)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Buffer Publishing Integration (Required for automated Instagram releases)
BUFFER_ACCESS_TOKEN=your_buffer_public_api_token_here
BUFFER_CHANNEL_ID=your_buffer_instagram_channel_id_here
BUFFER_ORGANIZATION_ID=your_buffer_organization_id_here

# 4. Optional Direct Instagram Graph API (Alternative to Buffer)
IG_USER_ID=your_instagram_user_id_here
IG_ACCESS_TOKEN=your_long_lived_instagram_access_token_here

# 5. Media Footage Ingestion
# Note: Pinterest session cookies can also be managed directly in the Settings UI.
GDRIVE_FOLDER_ID=your_gdrive_folder_id_here
PEXELS_API_KEY=your_pexels_api_key_here

# 6. Public Video Cloud Storage (Optional: supabase | r2 | local)
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
SUPABASE_BUCKET=reels

# Cloudflare R2 (Alternative to Supabase)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=reels
R2_PUBLIC_URL_PREFIX=https://pub-your-id.r2.dev
