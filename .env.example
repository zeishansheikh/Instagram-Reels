# Reel Forge API Key (Optional for FastAPI backend authentication)
REELFORGE_API_KEY=rf_dev_secret_key_2026

# Gemini API Key (Required for AI quote generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Pexels API Key (Optional for automated background video fetching)
PEXELS_API_KEY=your_pexels_api_key_here

# Google Drive Folder ID (Optional for remote asset synchronization)
GDRIVE_FOLDER_ID=your_gdrive_folder_id_here

# Instagram Graph API Publishing (Professional/Business/Creator Account)
IG_USER_ID=your_instagram_user_id_here
IG_ACCESS_TOKEN=your_long_lived_instagram_access_token_here

# Storage Provider for Public Video URLs: supabase | r2
STORAGE_PROVIDER=supabase

# Supabase Storage (Public bucket for temporary video delivery)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
SUPABASE_BUCKET=reels

# Cloudflare R2 (Alternative S3-compatible public storage)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=reels
R2_PUBLIC_URL_PREFIX=https://pub-your-id.r2.dev
